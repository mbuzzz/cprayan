# ==========================================
# PT. RAYAN SMART KREATIF - ENVIRONMENT CONFIG
# ==========================================

# Database Connection (SQLite local or PostgreSQL in Production)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth Security
NEXTAUTH_SECRET="your_nextauth_secret_key_minimum_32_characters_long"
NEXTAUTH_URL="http://localhost:3000"

# Public Application URL (Ganti dengan domain production Anda saat deploy, e.g. https://rayan.web.id)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# SUMOPOD PAYMENT GATEWAY CONFIGURATION
# ==========================================
# Sandbox Base URL: https://api-pay-sandbox.sumopod.com/api/v1
# Production Base URL: https://api-pay.sumopod.com/api/v1
SUMOPOD_BASE_URL="https://api-pay-sandbox.sumopod.com/api/v1"

# Sumopod API Key (Dapatkan dari dashboard merchant Sumopod Anda)
SUMOPOD_API_KEY="166b0a48cccd4de36594ac8abe8b86f24e3276b24a7323dcbed9863a8daa4cef"

# Optional: Webhook Secret Token untuk validasi callback
SUMOPOD_WEBHOOK_SECRET="your_webhook_secret_key_here"

# ==========================================
# SMTP EMAIL CONFIGURATION (Opsional / Dapat diatur via Admin Panel)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@rayan.web.id"
SMTP_PASS="your_smtp_app_password"
SMTP_SECURE="false"
SMTP_FROM="PT. Rayan Smart Kreatif <noreply@rayan.web.id>"
ADMIN_EMAIL="contact@rayan.web.id"
